<UserControl x:Class="SiemensXmlCreation.Views.NodePropView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SiemensXmlCreation.Views"
             mc:Ignorable="d" 
             xmlns:helpers="clr-namespace:CadMacro.Simulator.CommonControls.Helpers"
             xmlns:converters="clr-namespace:SiemensXmlCreation.Converters"
             d:DesignHeight="500" d:DesignWidth="800" Background="White">
    <UserControl.Resources>
        <converters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter"/>
        <converters:ValueToArray x:Key="ValueToArray"/>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Margin" Value="10,0,0,5"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Margin" Value="10,0,0,5"/>
            <Setter Property="Width" Value="130"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Margin" Value="10,0,0,5"/>
            <Setter Property="Width" Value="200"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Margin" Value="10,5,5,5"/>
            <Setter Property="Width" Value="100"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10,10,10,10">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="NodeControlType"/>
                <ComboBox ItemsSource="{Binding ControlTypes}" SelectedItem="{Binding ControlType}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="HeaderTitle"/>
                <TextBox Text="{Binding HeaderTitle,UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="CanShowHeader"/>
                <ComboBox ItemsSource="{Binding CanShowTypes}" SelectedItem="{Binding CanShowHeader}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding HeaderValueVisibility}">
                <TextBlock Text="HeaderValue"/>
                <TextBox Text="{Binding HeaderValue,UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding HeaderContentTypeVisibility}">
                <TextBlock Text="HeaderContentType"/>
                <ComboBox ItemsSource="{Binding HeaderContentTypes}" SelectedItem="{Binding HeaderContentType}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding HeaderInputTypeVisibility}">
                <TextBlock Text="HeaderInputType"/>
                <ComboBox ItemsSource="{Binding HeaderInputTypes}" SelectedItem="{Binding HeaderInputType}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding HeaderItemSourceTypeVisibility}">
                <TextBlock Text="HeaderItemSourceType"/>
                <ComboBox ItemsSource="{Binding HeaderItemSourceTypes}" SelectedItem="{Binding HeaderItemSourceType}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding HeaderItemSourceVisibility}">
                <TextBlock Text="HeaderItemSource"/>
                <TextBox Text="{Binding HeaderItemSource,UpdateSourceTrigger=LostFocus,Mode=TwoWay,Converter={StaticResource ValueToArray}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding FooterTitleVisibility}">
                <TextBlock Text="FooterTitle"/>
                <TextBox Text="{Binding FooterTitle,UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding FooterValueVisibility}">
                <TextBlock Text="FooterValue"/>
                <TextBox Text="{Binding FooterValue,UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding FooterContentTypeVisibility}">
                <TextBlock Text="FooterContentType"/>
                <ComboBox ItemsSource="{Binding FooterContentTypes}" SelectedItem="{Binding FooterContentType}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding FooterInputTypeVisibility}">
                <TextBlock Text="FooterInputType"/>
                <ComboBox ItemsSource="{Binding FooterInputTypes}" SelectedItem="{Binding FooterInputType}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding FooterItemSourceVisibility}">
                <TextBlock Text="FooterItemSource"/>
                <TextBox Text="{Binding FooterItemSource,UpdateSourceTrigger=LostFocus,Mode=TwoWay,Converter={StaticResource ValueToArray}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding FooterItemSourceTypeVisibility}">
                <TextBlock Text="FooterItemSourceType"/>
                <ComboBox ItemsSource="{Binding FooterItemSourceTypes}" SelectedItem="{Binding FooterItemSourceType}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding UnitVisibility}">
                <TextBlock Text="Unit"/>
                <TextBox Text="{Binding Unit,UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ImageSource"/>
                <TextBox Text="{Binding ImageSource,UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding LoadImageNameCommand}" Content="LoadDefultName" HorizontalAlignment="Left" Margin="5,5,5,5"/>
                <Button Content="Settings" Command="{Binding SettingsCommand}"/>
                <Button Content="TakeSnap" Command="{Binding SnapCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="GifSource"/>
                <TextBox Text="{Binding GifSource,UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ToolTip"/>
                <TextBox Text="{Binding ToolTip,UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Add" Command="{Binding AddCommand}"/>
                <Button Content="Remove" Command="{Binding RemoveCommand}"/>
                <Button Content="AddToMacros" Command="{Binding AddToMacrosCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
